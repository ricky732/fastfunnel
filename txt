within;
package SimpleTest "Modello minimo per provare l'esecuzione batch di Dymola"

  model FirstOrder "Gradino unitario in un primo ordine: y(5 s) = 1 - exp(-5) = 0.99326"
    Modelica.Blocks.Sources.Step step(height=1, startTime=0)
      annotation (Placement(transformation(extent={{-60,-10},{-40,10}})));
    Modelica.Blocks.Continuous.FirstOrder fo(
      k=1,
      T=1,
      initType=Modelica.Blocks.Types.Init.InitialOutput,
      y_start=0)
      annotation (Placement(transformation(extent={{-10,-10},{10,10}})));
    Real y = fo.y "Segnale controllato dal test";
  equation
    connect(step.y, fo.u)
      annotation (Line(points={{-39,0},{-12,0}}, color={0,0,127}));
    annotation (experiment(StopTime=5, Tolerance=1e-6));
  end FirstOrder;

end SimpleTest;